# ==============================================================================
# SAIT Anonymous Ask Us Anything — Environment Configuration
# ==============================================================================

# Supabase Project URL (From Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (From Supabase Dashboard > Settings > API > Project API Keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Key (From Supabase Dashboard > Settings > API > Project API Keys > service_role)
# CRITICAL: Keep this private! Never expose to browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Organizer Admin Access PIN (Used to log into /admin)
# Choose a secure memorable PIN for your organizing team.
ADMIN_PIN=SAIT2026

# Secret key used for signing HttpOnly admin session cookies
ADMIN_SESSION_SECRET=sait_super_secret_session_encryption_key_change_me_in_production

# Public URL of the deployed application (used for generating downloadable QR codes)
# In development: http://localhost:3000
# In production: https://sait-quiz.vercel.app (or custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
